# Stable Python version (avoid bleeding edge use 3.12 for CI)
FROM python:3.14-slim-bookworm

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    jq \
    bc \
    git \
    
    bash \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip first (important for slim images)
RUN pip install --no-cache-dir --upgrade pip

# Install Python tools used in pipeline
RUN pip install --no-cache-dir \
    pytest \
    checkov

# Install Terraform (pin version for stability)
ARG TERRAFORM_VERSION=1.6.6
RUN curl -fsSL https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip -o terraform.zip \
    && unzip terraform.zip \
    && mv terraform /usr/local/bin/ \
    && rm terraform.zip

# Default workdir for Jenkins
WORKDIR /workspace

# Keep container alive for Jenkins
CMD ["cat"]
